# Backend
DATABASE_URL=postgresql://kronos:kronos@localhost:5432/kronos?schema=public
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
PREDICTION_TIMEOUT_MS=600000
BACKTEST_TIMEOUT_MS=1800000

# AI service
MODEL_ID=NeoQuasar/Kronos-base
TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
MODEL_VERSION=kronos-base
DEVICE=auto
SKIP_MODEL_LOAD=false
HF_HOME=.cache/huggingface
# Windows without Developer Mode cannot create HF cache symlinks. Downloading
# with `local_dir` (see README) or running the service in Docker avoids this.
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
